    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this student enrollment row and return ONLY a JSON object.\n\nRow data: {{ JSON.stringify($json) }}\n\nRules:\n\nStudent_ID: Keep as-is or fix formatting if broken.\n\nName: Title Case (e.g., \"manoj k\" → \"Manoj K\").\n\nEmail: Convert to lowercase. If invalid, set to \"INVALID_EMAIL\".\n\nPhone: If fewer than 10 digits, set to \"MISSING\".\n\nCourse: Standardize to only Python, Machine Learning, or Data Science. Correct obvious typos when the intended course is clear.\n\nFee_Paid: yes/YES = true, no/NO = false.\n\nCity: Title Case; if empty, set to \"UNKNOWN\".\n\nEnrolled_Date: Convert to YYYY-MM-DD format if the date is unambiguous.\n\nEmail_Valid: Return true if the email has a plausible email format; otherwise, return false.\n\nDo not invent missing information.\n\nPreserve all original fields and include the additional Email_Valid field.\n\nReturn ONLY valid raw JSON. No explanations, no Markdown code fences.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -112,
        -16
      ],
      "id": "ae230ac9-c284-412a-bbc6-08839133f035",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        -224,
        192
      ],
      "id": "1cde1d54-5806-41ea-8114-3a122bae3a3c",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "1Kip3KteAOqPIavw",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n// Process all 50 incoming items, one at a time\nreturn $input.all().map(item => {\n  // 1. Get the AI-generated response\n  const rawText = item.json.text;\n\n  // 2. Parse the JSON string into an object\n  let data;\n\n  try {\n    data = typeof rawText === 'string'\n      ? JSON.parse(rawText.trim())\n      : rawText;\n  } catch (error) {\n    throw new Error(\n      `Could not parse AI response: ${String(rawText).slice(0, 200)}`\n    );\n  }\n\n  // Handle a response containing a single object only\n  if (!data || typeof data !== 'object' || Array.isArray(data)) {\n    throw new Error('Expected one student JSON object per item.');\n  }\n\n  // 3. Clean text fields\n  const studentId = String(data.Student_ID ?? '').trim();\n  const name = String(data.Name ?? '')\n    .trim()\n    .replace(/\\s+/g, ' ')\n    .toLowerCase()\n    .replace(/\\b[a-z]/g, char => char.toUpperCase());\n\n  const email = String(data.Email ?? '')\n    .trim()\n    .toLowerCase();\n\n  const course = String(data.Course ?? '')\n    .trim()\n    .replace(/\\s+/g, ' ')\n    .toLowerCase()\n    .replace(/\\b[a-z]/g, char => char.toUpperCase());\n\n  const city = String(data.City ?? '')\n    .trim()\n    .replace(/\\s+/g, ' ')\n    .toLowerCase()\n    .replace(/\\b[a-z]/g, char => char.toUpperCase());\n\n  // 4. Normalize phone number\n  const phone = String(data.Phone ?? '')\n    .replace(/\\D/g, '');\n\n  // 5. Recheck email format\n  const emailValid = emailRegex.test(email);\n\n  // 6. Convert Fee_Paid safely to true/false\n  const feeValue = String(data.Fee_Paid ?? '')\n    .trim()\n    .toLowerCase();\n\n  let feePaid;\n  if (['true', 'yes'].includes(feeValue)) {\n    feePaid = true;\n  } else if (['false', 'no'].includes(feeValue)) {\n    feePaid = false;\n  } else {\n    feePaid = null;\n  }\n\n  // 7. Preserve the AI-standardized date\n  const enrolledDate = String(data.Enrolled_Date ?? '').trim();\n\n  // 8. Return one structured student record\n  return {\n    json: {\n      Student_ID: studentId,\n      Name: name,\n      Email: email,\n      Phone: phone,\n      Course: course,\n      Fee_Paid: feePaid,\n      City: city,\n      Enrolled_Date: enrolledDate,\n      Email_Valid: emailValid\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
